{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.run/schemas/context-learned-canary-admission.schema.json",
  "title": "Learned compressor local-canary admission request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "candidate_id",
    "source_repo",
    "source_commit",
    "package_version",
    "license",
    "runtime_facts"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "context-learned-canary-admission"},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "source_repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_version": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]{1,40}$"},
    "license": {"type": "string", "pattern": "^[A-Za-z0-9.-]{1,40}$"},
    "runtime_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "artifact_digest", "evidence_revision"],
      "properties": {
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "runtime_facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_mode": {
          "type": "string",
          "enum": ["LOCAL_ONLY", "HOSTED", "HYBRID", "UNKNOWN"]
        },
        "endpoint_class": {
          "type": "string",
          "enum": ["LOOPBACK", "PRIVATE_NETWORK", "PUBLIC_NETWORK", "UNKNOWN"]
        },
        "external_egress": {
          "type": "string",
          "enum": ["DENY", "ALLOW", "UNKNOWN"]
        },
        "protected_state_route": {
          "type": "string",
          "enum": ["BYPASS", "COMPRESS", "UNKNOWN"]
        },
        "deterministic_bypass": {"type": ["boolean", "null"]},
        "exact_original_recovery_verified": {"type": ["boolean", "null"]},
        "identifier_preservation_verified": {"type": ["boolean", "null"]},
        "cache_behavior_verified": {"type": ["boolean", "null"]},
        "provider_usage_capture_ready": {"type": ["boolean", "null"]},
        "live_comparability_gate_available": {"type": ["boolean", "null"]},
        "shadow_equivalence_gate_available": {"type": ["boolean", "null"]}
      }
    }
  }
}
