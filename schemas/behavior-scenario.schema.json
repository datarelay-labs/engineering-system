{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavior eval scenario catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scenarios"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mandatory", "safety", "title", "invariant", "checker"],
        "properties": {
          "id": {"type": "string", "pattern": "^BEH-[A-Z0-9-]+$"},
          "mandatory": {"type": "boolean"},
          "safety": {"type": "boolean"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "invariant": {"type": "string", "minLength": 1, "maxLength": 240},
          "checker": {
            "type": "string",
            "enum": [
              "context",
              "work_packet",
              "affected",
              "resource",
              "wait",
              "taskswitch",
              "review",
              "adoption",
              "permissions",
              "trust"
            ]
          }
        }
      }
    }
  }
}
