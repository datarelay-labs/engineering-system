{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider-neutral efficiency telemetry",
  "oneOf": [
    {"$ref": "#/$defs/record"},
    {"$ref": "#/$defs/report"},
    {"$ref": "#/$defs/decision"}
  ],
  "$defs": {
    "sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "nullable_name": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:@\\[\\]=,+-]{1,80}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "repo",
        "workstream",
        "task_kind",
        "profile",
        "profile_switches",
        "started_at",
        "finished_at",
        "duration_seconds",
        "usage",
        "counts",
        "validation",
        "terminal",
        "budget"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "kind": {"type": "string", "const": "efficiency-telemetry"},
        "run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "workstream": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"},
        "task_kind": {
          "type": "string",
          "enum": [
            "DESIGN",
            "DEVELOPMENT",
            "TEST",
            "REVIEW",
            "RELEASE",
            "OPERATIONS",
            "ADOPTION",
            "DOCUMENTATION",
            "CLEANUP",
            "MIXED"
          ]
        },
        "profile": {"$ref": "#/$defs/profile"},
        "profile_switches": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/switch"}
        },
        "started_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "duration_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400},
        "usage": {"$ref": "#/$defs/usage"},
        "counts": {"$ref": "#/$defs/counts"},
        "validation": {"$ref": "#/$defs/validation"},
        "terminal": {"type": "string", "enum": ["PASS", "BLOCK", "FAIL"]},
        "budget": {"$ref": "#/$defs/budget"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoning", "toolset"],
      "properties": {
        "provider": {"$ref": "#/$defs/nullable_name"},
        "model": {"$ref": "#/$defs/nullable_name"},
        "reasoning": {"$ref": "#/$defs/nullable_name"},
        "toolset": {"$ref": "#/$defs/nullable_name"}
      }
    },
    "switch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "from", "to", "justification"],
      "properties": {
        "field": {"type": "string", "enum": ["provider", "model", "reasoning", "toolset"]},
        "from": {"$ref": "#/$defs/nullable_name"},
        "to": {"$ref": "#/$defs/nullable_name"},
        "justification": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,80}$"}
      }
    },
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "cost"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 100000000},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 100000000},
        "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 100000000},
        "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 100000000},
        "cost": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_turns",
        "retries",
        "rereads",
        "compactions",
        "pr_rework",
        "ci_rework",
        "review_rework",
        "human_interventions"
      ],
      "properties": {
        "tool_turns": {"$ref": "#/$defs/count"},
        "retries": {"$ref": "#/$defs/count"},
        "rereads": {"$ref": "#/$defs/count"},
        "compactions": {"$ref": "#/$defs/count"},
        "pr_rework": {"$ref": "#/$defs/count"},
        "ci_rework": {"$ref": "#/$defs/count"},
        "review_rework": {"$ref": "#/$defs/count"},
        "human_interventions": {"$ref": "#/$defs/count"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids", "exact_head", "evidence_state", "outcome"],
      "properties": {
        "ids": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,40}$"}
        },
        "exact_head": {"$ref": "#/$defs/sha"},
        "evidence_state": {"type": "string", "enum": ["EXACT_HEAD", "STALE", "MISSING"]},
        "outcome": {"type": "string", "enum": ["PASS", "BLOCK", "FAIL", "UNKNOWN"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soft_limit", "consumed", "unit", "state", "disposition"],
      "properties": {
        "soft_limit": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000000},
        "consumed": {"type": ["integer", "null"], "minimum": 0, "maximum": 100000000},
        "unit": {"type": ["string", "null"], "enum": ["tokens", "cost_micros", "turns", null]},
        "state": {"type": "string", "enum": ["WITHIN", "EXHAUSTED", "UNKNOWN"]},
        "disposition": {"type": "string", "enum": ["CONTINUE", "YIELD"]}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "head",
        "evidence_state",
        "terminal",
        "validation_outcome",
        "record_count",
        "duration_seconds",
        "cost",
        "rework_count",
        "human_interventions"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "kind": {"type": "string", "const": "efficiency-outcome-report"},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "evidence_state": {"type": "string", "enum": ["EXACT_HEAD", "STALE", "MISSING"]},
        "terminal": {"type": "string", "enum": ["PASS", "BLOCK", "FAIL"]},
        "validation_outcome": {"type": "string", "enum": ["PASS", "BLOCK", "FAIL", "UNKNOWN"]},
        "record_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "duration_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400},
        "cost": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000},
        "rework_count": {"$ref": "#/$defs/count"},
        "human_interventions": {"$ref": "#/$defs/count"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "state", "disposition", "terminal"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "kind": {"type": "string", "const": "task-budget-decision"},
        "state": {"type": "string", "enum": ["WITHIN", "EXHAUSTED", "UNKNOWN"]},
        "disposition": {"type": "string", "enum": ["CONTINUE", "YIELD"]},
        "terminal": {"type": ["string", "null"], "enum": ["BLOCK", null]}
      }
    }
  }
}
