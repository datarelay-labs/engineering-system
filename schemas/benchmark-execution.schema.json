{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BENCH-BUG-001 execution dry-run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "case_id",
    "manifest_git_sha",
    "fixture_id",
    "comparison",
    "reason",
    "execute_worker",
    "network",
    "lanes"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "benchmark-execution-dry-run"},
    "case_id": {"type": "string", "const": "BENCH-BUG-001"},
    "manifest_git_sha": {"$ref": "#/$defs/sha"},
    "fixture_id": {"type": "string", "const": "2990e6683f87a9858c4441e719ebf78b643c7ded:BENCH-BUG-001"},
    "comparison": {"type": "string", "enum": ["COMPARABLE", "PARTIAL", "BLOCK"]},
    "reason": {"type": "string", "enum": ["PROFILE_MATCH", "PROFILE_MISMATCH", "PROFILE_INCOMPLETE"]},
    "execute_worker": {"type": "boolean", "const": false},
    "network": {"type": "string", "const": "NONE"},
    "lanes": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/lane"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"comparison": {"const": "COMPARABLE"}},
        "required": ["comparison"]
      },
      "then": {
        "properties": {
          "reason": {"const": "PROFILE_MATCH"},
          "lanes": {"minItems": 2, "maxItems": 2}
        }
      }
    },
    {
      "if": {
        "properties": {"comparison": {"const": "PARTIAL"}},
        "required": ["comparison"]
      },
      "then": {
        "properties": {
          "reason": {"const": "PROFILE_MISMATCH"},
          "lanes": {"minItems": 2, "maxItems": 2}
        }
      }
    },
    {
      "if": {
        "properties": {"comparison": {"const": "BLOCK"}},
        "required": ["comparison"]
      },
      "then": {
        "properties": {
          "reason": {"const": "PROFILE_INCOMPLETE"},
          "lanes": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoning", "toolset"],
      "properties": {
        "provider": {"$ref": "#/$defs/name"},
        "model": {"$ref": "#/$defs/name"},
        "reasoning": {"$ref": "#/$defs/name"},
        "toolset": {"$ref": "#/$defs/name"}
      }
    },
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_.:@\\[\\]=,+-]{1,80}$"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "repository",
        "source_commit",
        "objective",
        "objective_codes",
        "reset",
        "excludes_secrets",
        "excludes_production_mutation"
      ],
      "properties": {
        "case_id": {"type": "string", "const": "BENCH-BUG-001"},
        "repository": {"type": "string", "const": "datarelay-labs/engineering-system"},
        "source_commit": {"type": "string", "const": "3cdedad5a40105aea426abda0df8d7c258e5e8ad"},
        "objective": {"type": "string", "minLength": 1, "maxLength": 240},
        "objective_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,80}$"}
        },
        "reset": {"type": "string", "const": "FRESH_WORKTREE_SESSION"},
        "excludes_secrets": {"type": "boolean", "const": true},
        "excludes_production_mutation": {"type": "boolean", "const": true}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reset", "relative_directory", "execute_worker", "production_mutation"],
      "properties": {
        "reset": {"type": "string", "const": "FRESH_WORKTREE_SESSION"},
        "relative_directory": {"type": "string", "pattern": "^benchmark-dry-run/BENCH-BUG-001/(control|candidate)$"},
        "execute_worker": {"type": "boolean", "const": false},
        "production_mutation": {"type": "boolean", "const": false}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CASE_ID",
        "SYSTEM_VERSION",
        "SYSTEM_HEAD",
        "FIXTURE_ID",
        "TERMINAL",
        "CORRECT_BEHAVIOR",
        "SAFETY_REGRESSION",
        "REGRESSION_TESTS",
        "EXACT_HEAD_EVIDENCE",
        "RELEVANT_CONTEXT",
        "WALL_SECONDS",
        "MODEL_COST",
        "RETRIES",
        "REREADS",
        "COMPACTIONS",
        "REVIEW_REWORK",
        "HUMAN_INTERVENTIONS",
        "HOST_RESOURCE_OUTCOME",
        "NOTES_CODE"
      ],
      "properties": {
        "CASE_ID": {"type": "string", "const": "BENCH-BUG-001"},
        "SYSTEM_VERSION": {"type": "string", "minLength": 1},
        "SYSTEM_HEAD": {"$ref": "#/$defs/sha"},
        "FIXTURE_ID": {"type": "string", "const": "2990e6683f87a9858c4441e719ebf78b643c7ded:BENCH-BUG-001"},
        "TERMINAL": {"type": "string", "const": "BLOCK"},
        "CORRECT_BEHAVIOR": {"type": "string", "const": "UNKNOWN"},
        "SAFETY_REGRESSION": {"type": "string", "const": "UNKNOWN"},
        "REGRESSION_TESTS": {"type": "string", "const": "BLOCK"},
        "EXACT_HEAD_EVIDENCE": {"type": "string", "const": "MISSING"},
        "RELEVANT_CONTEXT": {"type": "string", "const": "MISSING"},
        "WALL_SECONDS": {"type": "string", "const": "UNKNOWN"},
        "MODEL_COST": {"type": "string", "const": "UNKNOWN"},
        "RETRIES": {"type": "integer", "const": 0},
        "REREADS": {"type": "integer", "const": 0},
        "COMPACTIONS": {"type": "integer", "const": 0},
        "REVIEW_REWORK": {"type": "integer", "const": 0},
        "HUMAN_INTERVENTIONS": {"type": "integer", "const": 0},
        "HOST_RESOURCE_OUTCOME": {"type": "string", "const": "UNKNOWN"},
        "NOTES_CODE": {"type": "string", "const": "DRY_RUN_NOT_EXECUTED"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantics", "profile", "duration_seconds", "usage", "counts"],
      "properties": {
        "semantics": {"type": "string", "const": "efficiency-telemetry"},
        "profile": {"$ref": "#/$defs/profile"},
        "duration_seconds": {"type": "null"},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "cost"],
          "properties": {
            "input_tokens": {"type": "null"},
            "output_tokens": {"type": "null"},
            "cache_read_tokens": {"type": "null"},
            "cache_write_tokens": {"type": "null"},
            "cost": {"type": "null"}
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retries", "rereads", "compactions", "review_rework", "human_interventions"],
          "properties": {
            "retries": {"type": "integer", "const": 0},
            "rereads": {"type": "integer", "const": 0},
            "compactions": {"type": "integer", "const": 0},
            "review_rework": {"type": "integer", "const": 0},
            "human_interventions": {"type": "integer", "const": 0}
          }
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "system_version",
        "system_head",
        "fixture_id",
        "task_source_head",
        "worker_payload",
        "profile",
        "isolation",
        "result",
        "telemetry"
      ],
      "properties": {
        "lane": {"type": "string", "enum": ["CONTROL", "CANDIDATE"]},
        "system_version": {"type": "string", "minLength": 1},
        "system_head": {"$ref": "#/$defs/sha"},
        "fixture_id": {"type": "string", "const": "2990e6683f87a9858c4441e719ebf78b643c7ded:BENCH-BUG-001"},
        "task_source_head": {"type": "string", "const": "3cdedad5a40105aea426abda0df8d7c258e5e8ad"},
        "worker_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "run"],
          "properties": {
            "task": {"$ref": "#/$defs/task"},
            "run": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lane",
                "case_id",
                "system_version",
                "system_head",
                "fixture_manifest_head",
                "fixture_id",
                "task_source_head",
                "profile",
                "isolation"
              ],
              "properties": {
                "lane": {"type": "string", "enum": ["CONTROL", "CANDIDATE"]},
                "case_id": {"type": "string", "const": "BENCH-BUG-001"},
                "system_version": {"type": "string", "minLength": 1},
                "system_head": {"$ref": "#/$defs/sha"},
                "fixture_manifest_head": {"type": "string", "const": "2990e6683f87a9858c4441e719ebf78b643c7ded"},
                "fixture_id": {"type": "string", "const": "2990e6683f87a9858c4441e719ebf78b643c7ded:BENCH-BUG-001"},
                "task_source_head": {"type": "string", "const": "3cdedad5a40105aea426abda0df8d7c258e5e8ad"},
                "profile": {"$ref": "#/$defs/profile"},
                "isolation": {"$ref": "#/$defs/isolation"}
              }
            }
          }
        },
        "profile": {"$ref": "#/$defs/profile"},
        "isolation": {"$ref": "#/$defs/isolation"},
        "result": {"$ref": "#/$defs/result"},
        "telemetry": {"$ref": "#/$defs/telemetry"}
      }
    }
  }
}
