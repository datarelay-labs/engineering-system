{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.run/schemas/context-canary-comparison.schema.json",
  "title": "Context canary comparison envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_set", "telemetry_bindings"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "context-canary-comparison"},
    "run_set": {"type": "object"},
    "telemetry_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm_id", "case_id", "telemetry"],
        "properties": {
          "arm_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^(?:CTX|BENCH)-[A-Z0-9-]{1,72}$"
          },
          "telemetry": {"type": "object"}
        }
      }
    }
  }
}
