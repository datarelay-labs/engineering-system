{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Relay Labs Project Profile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "engineering_system",
    "project",
    "domains"
  ],
  "properties": {
    "engineering_system": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["canonical", "adopted"]
        },
        "baseline": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ci_mode": {
          "type": "string",
          "enum": ["shared", "native"]
        },
        "native_ci_workflows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "merge_gate_status": {
          "type": "string",
          "enum": ["verified", "advisory", "unknown"]
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "type",
        "maturity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "type": "string",
          "enum": [
            "experimental",
            "development",
            "production",
            "maintenance"
          ]
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "object",
      "properties": {
        "production_oriented": {"type": "boolean"},
        "runbook_required": {"type": "boolean"},
        "incident_response_required": {"type": "boolean"}
      }
    }
  }
}
