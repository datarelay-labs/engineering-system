{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering System User Acceptance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate", "run_id", "candidate_head", "contract_path",
    "contract_sha256", "contract_dirty", "final_status", "head_unchanged",
    "executor", "final_auditor", "chatgpt_direct_persona_execution",
    "actual_user_surface", "scripted_user_substitution",
    "finding_accumulation_complete", "evidence_ledger_schema",
    "summary_derived_from_ledger", "report_consistency",
    "mandatory_total", "mandatory_pass", "mandatory_fail",
    "mandatory_partial", "mandatory_blocked", "unresolved_blocking_findings",
    "capability_coverage_pct", "public_surface_coverage_pct",
    "use_case_coverage_pct", "real_effect_coverage_pct", "cleanup_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gate": {"enum": ["SURFACE_RECONCILIATION", "FULL_USER_E2E"]},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_path": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_dirty": {"type": "boolean"},
    "final_status": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED"]},
    "head_unchanged": {"type": "boolean"},
    "executor": {"const": "CHATGPT"},
    "final_auditor": {"const": "CHATGPT"},
    "chatgpt_direct_persona_execution": {"type": "boolean"},
    "actual_user_surface": {"type": "boolean"},
    "scripted_user_substitution": {"type": "boolean"},
    "finding_accumulation_complete": {"type": "boolean"},
    "evidence_ledger_schema": {"enum": ["PASS", "FAIL"]},
    "summary_derived_from_ledger": {"type": "boolean"},
    "report_consistency": {"enum": ["PASS", "FAIL"]},
    "mandatory_total": {"type": "integer", "minimum": 1},
    "mandatory_pass": {"type": "integer", "minimum": 0},
    "mandatory_fail": {"type": "integer", "minimum": 0},
    "mandatory_partial": {"type": "integer", "minimum": 0},
    "mandatory_blocked": {"type": "integer", "minimum": 0},
    "unresolved_blocking_findings": {"type": "integer", "minimum": 0},
    "capability_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "public_surface_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "use_case_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "real_effect_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "cleanup_status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
    "evidence_root": {"type": "string"},
    "notes": {"type": "string"}
  }
}
