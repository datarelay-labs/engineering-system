{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering System User Acceptance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate", "run_id", "candidate_head", "contract_path",
    "contract_sha256", "contract_dirty", "final_status", "head_unchanged",
    "executor", "runtime", "final_auditor", "direct_persona_execution",
    "actual_user_surface", "scripted_user_substitution",
    "finding_accumulation_complete", "evidence_ledger_schema",
    "summary_derived_from_ledger", "report_consistency",
    "mandatory_total", "mandatory_pass", "mandatory_fail",
    "mandatory_partial", "mandatory_blocked", "unresolved_blocking_findings",
    "capability_coverage_pct", "public_surface_coverage_pct",
    "use_case_coverage_pct", "real_effect_coverage_pct", "cleanup_status"
  ],
  "$defs": {
    "utc_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "issue_comment_ref": {
      "type": "string",
      "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "gate": {"enum": ["SURFACE_RECONCILIATION", "FULL_USER_E2E"]},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_path": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_dirty": {"type": "boolean"},
    "final_status": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED"]},
    "head_unchanged": {"type": "boolean"},
    "user_execution_mode": {"enum": ["AI_DIRECT", "HUMAN_OWNER_WITH_CHATGPT_AUDIT"]},
    "human_owner_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_head", "contract_sha256", "run_id",
        "owner_instruction_reference", "owner_observation_reference",
        "chatgpt_audit_reference", "chatgpt_audit_claim", "client",
        "started_at", "completed_at", "operator_reported_cleanup", "scenarios"
      ],
      "properties": {
        "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "owner_instruction_reference": {"$ref": "#/$defs/issue_comment_ref"},
        "owner_observation_reference": {"$ref": "#/$defs/issue_comment_ref"},
        "chatgpt_audit_reference": {"$ref": "#/$defs/issue_comment_ref"},
        "chatgpt_audit_claim": {"enum": ["PASS", "FAIL", "BLOCK", "UNKNOWN"]},
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "version", "target", "process_observation_reference"],
          "properties": {
            "kind": {"enum": ["CHROME", "CHROMIUM", "PRIMARY_CLI", "DESKTOP", "MOBILE"]},
            "name": {"type": "string", "minLength": 1, "maxLength": 80},
            "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "target": {"type": "string", "minLength": 5, "maxLength": 240},
            "process_observation_reference": {"$ref": "#/$defs/issue_comment_ref"}
          }
        },
        "started_at": {"$ref": "#/$defs/utc_time"},
        "completed_at": {"$ref": "#/$defs/utc_time"},
        "operator_reported_cleanup": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
        "scenarios": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": [
              "id", "executed_at", "result", "expected", "observed",
              "evidence_reference", "screenshot_sha256", "readback_reference"
            ],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,79}$"},
              "executed_at": {"$ref": "#/$defs/utc_time"},
              "result": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED"]},
              "expected": {"type": "string", "minLength": 1, "maxLength": 300},
              "observed": {"type": "string", "minLength": 1, "maxLength": 300},
              "evidence_reference": {"$ref": "#/$defs/issue_comment_ref"},
              "screenshot_sha256": {
                "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
              },
              "readback_reference": {
                "oneOf": [{"$ref": "#/$defs/issue_comment_ref"}, {"type": "null"}]
              }
            }
          }
        }
      }
    },
    "executor": {"enum": ["EXECUTION_PROFILE", "HUMAN_OWNER"]},
    "runtime": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "final_auditor": {"const": "EXECUTION_PROFILE"},
    "direct_persona_execution": {"type": "boolean"},
    "actual_user_surface": {"type": "boolean"},
    "scripted_user_substitution": {"type": "boolean"},
    "finding_accumulation_complete": {"type": "boolean"},
    "evidence_ledger_schema": {"enum": ["PASS", "FAIL"]},
    "summary_derived_from_ledger": {"type": "boolean"},
    "report_consistency": {"enum": ["PASS", "FAIL"]},
    "mandatory_total": {"type": "integer", "minimum": 1},
    "mandatory_pass": {"type": "integer", "minimum": 0},
    "mandatory_fail": {"type": "integer", "minimum": 0},
    "mandatory_partial": {"type": "integer", "minimum": 0},
    "mandatory_blocked": {"type": "integer", "minimum": 0},
    "unresolved_blocking_findings": {"type": "integer", "minimum": 0},
    "capability_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "public_surface_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "use_case_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "real_effect_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "cleanup_status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
    "evidence_root": {"type": "string"},
    "notes": {"type": "string"}
  }
}
