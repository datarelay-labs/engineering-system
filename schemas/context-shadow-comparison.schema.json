{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.run/schemas/context-shadow-comparison.schema.json",
  "title": "Context shadow action-equivalence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "control_arm_id", "canary", "observations"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "context-shadow-comparison"},
    "control_arm_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "canary": {"type": "object"},
    "observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm_id", "case_id", "telemetry_run_id", "actions"],
        "properties": {
          "arm_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^(?:CTX|BENCH)-[A-Z0-9-]{1,72}$"
          },
          "telemetry_run_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "target"],
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "ORIENT",
                    "RETRIEVE",
                    "EDIT",
                    "TEST",
                    "REVIEW",
                    "EXTERNAL_WRITE",
                    "WAIT",
                    "BLOCK",
                    "COMPLETE"
                  ]
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "REPOSITORY",
                    "FILE",
                    "TEST",
                    "PR",
                    "ISSUE",
                    "CI",
                    "RUNTIME",
                    "NONE"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
