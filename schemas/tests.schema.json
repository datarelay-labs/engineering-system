{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering System Test Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "paths", "scenarios"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "setup_command": {
      "type": "string"
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["domains"],
        "properties": {
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name", "level", "domains", "command"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
          },
          "name": {"type": "string", "minLength": 1},
          "level": {
            "type": "string",
            "enum": ["static", "unit", "component", "feature", "integration", "ux", "lifecycle", "performance", "e2e"]
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "triggers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["affected", "pr", "preflight", "nightly", "rc", "release", "post-release"]
            }
          },
          "platforms": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "command": {"type": "string", "minLength": 1},
          "invariants": {
            "type": "array",
            "items": {"type": "string"}
          },
          "origin": {"type": "string"},
          "release_gate": {"type": "boolean"},
          "cost": {"type": "string", "enum": ["cheap", "medium", "expensive"]},
          "estimated_seconds": {"type": "integer", "minimum": 1},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "agent_default": {"type": "boolean"},
          "scope": {
            "type": "string",
            "enum": ["metadata", "static", "unit", "component", "feature", "integration", "full", "e2e"]
          }
        }
      }
    }
  }
}
