{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional feature verification map",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "automation_eligible", "features"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "automation_eligible": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/featureId"}
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "featureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "refId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "oracle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "refList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/refId"}
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "runtime", "skills", "profiles"],
      "properties": {
        "tests": {"$ref": "#/$defs/refList"},
        "runtime": {"$ref": "#/$defs/refList"},
        "skills": {"$ref": "#/$defs/refList"},
        "profiles": {"$ref": "#/$defs/refList"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "oracle", "minimum_level", "domains", "references"],
      "properties": {
        "id": {"$ref": "#/$defs/featureId"},
        "oracle": {"$ref": "#/$defs/oracle"},
        "minimum_level": {"type": "string", "enum": ["T1", "T2", "T3", "T4", "T5"]},
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/domain"}
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["launch", "drive", "observe", "cleanup"],
          "properties": {
            "launch": {"$ref": "#/$defs/role"},
            "drive": {"$ref": "#/$defs/role"},
            "observe": {"$ref": "#/$defs/role"},
            "cleanup": {"$ref": "#/$defs/role"}
          }
        }
      }
    }
  }
}
