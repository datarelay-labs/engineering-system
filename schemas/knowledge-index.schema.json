{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional repository knowledge index",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "domains"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "canonical"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 160},
          "canonical": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 180}
          }
        }
      }
    },
    "derived": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 180},
          "note": {"type": "string", "maxLength": 120}
        }
      }
    },
    "generated": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 180},
          "source": {"type": "string", "minLength": 1, "maxLength": 180},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
