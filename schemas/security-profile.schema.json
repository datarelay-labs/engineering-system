{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository security profile audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "reason", "controls", "mutation", "network"],
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "production-code",
        "development-code",
        "docs-site",
        "empty-preproduct",
        "NEEDS_INPUT"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "detail"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "REQUIRED_PASS",
              "REQUIRED_FAIL",
              "RECOMMENDED_PASS",
              "RECOMMENDED_GAP",
              "EQUIVALENT_EXTERNAL",
              "DEFERRED",
              "UNAVAILABLE",
              "NOT_APPLICABLE",
              "UNKNOWN"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "mutation": {
      "const": "NONE"
    },
    "network": {
      "const": "NONE"
    }
  }
}
