{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordinator planner decision",
  "$id": "https://github.com/datarelay-labs/engineering-system/schemas/coordinator-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "reason",
    "decision_class",
    "notification_disposition",
    "notification_key",
    "notification_suppress_reason",
    "subject_version",
    "launches_worker",
    "mutates_existing_sessions",
    "stops_unrelated_sessions",
    "spawns_process",
    "mutates_github",
    "sends_notification",
    "priority",
    "change_risk",
    "intent_revision",
    "repository",
    "workstream"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision": {
      "enum": [
        "NOOP_COMPLETE",
        "NOOP_PAUSED",
        "BLOCK_HUMAN",
        "WAIT_EXTERNAL",
        "RECONCILE_AMBIGUOUS",
        "ADMIT_IMPLEMENTATION",
        "RESUME_WORKER",
        "AUDIT_DIRTY_TREE",
        "AUTHORIZE_PUBLICATION",
        "WAIT_EXACT_HEAD_CI",
        "AUDIT_REVIEW",
        "MERGE_READY",
        "REPLAN_SEMANTIC_FAILURE",
        "YIELD_RESOURCE",
        "STALE_WORKER"
      ]
    },
    "reason": {"type": "string", "minLength": 1},
    "decision_class": {"type": "string", "minLength": 1},
    "notification_disposition": {"enum": ["SEND", "SUPPRESS"]},
    "notification_key": {"type": "string", "minLength": 1},
    "notification_suppress_reason": {"enum": ["NONE", "DEDUP", "IDENTICAL_WAIT", "WORKER_MICROSTEP"]},
    "subject_version": {"type": "string", "minLength": 1},
    "launches_worker": {"type": "boolean"},
    "mutates_existing_sessions": {"const": false},
    "stops_unrelated_sessions": {"const": false},
    "spawns_process": {"const": false},
    "mutates_github": {"const": false},
    "sends_notification": {"const": false},
    "priority": {"enum": ["URGENT", "HIGH", "NORMAL", "LOW"]},
    "change_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "intent_revision": {"type": "integer", "minimum": 1},
    "repository": {"type": "string", "minLength": 3},
    "workstream": {"type": "string", "minLength": 1}
  }
}
