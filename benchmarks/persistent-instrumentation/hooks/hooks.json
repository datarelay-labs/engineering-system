{
  "version": 1,
  "hooks": {
    "sessionStart": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py"}],
    "sessionEnd": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py"}],
    "beforeSubmitPrompt": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py", "failClosed": true}],
    "preToolUse": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py", "failClosed": true}],
    "beforeShellExecution": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py", "failClosed": true}],
    "beforeMCPExecution": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py", "failClosed": true}],
    "postToolUse": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py"}],
    "postToolUseFailure": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py"}],
    "preCompact": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py"}],
    "stop": [{"command": "python3 ${CURSOR_PLUGIN_ROOT}/hooks/record.py"}]
  }
}
